local BYPASS_API = API_BASE .. "/api/bypass/check"
local function checkBypassAPI(username)
    local ok, result = pcall(function()
        local reqFunc = (syn and syn.request) or http_request or request or (fluxus and fluxus.request)
        if not reqFunc then return nil end
        local response = reqFunc({
            Url = BYPASS_API,
            Method = "POST",
            Headers = {["Content-Type"] = "application/json"},
            Body = HttpService:JSONEncode({username = username})
        })
        return HttpService:JSONDecode(response.Body)
    end)
    if ok and result and result.bypass then
        return true
    end
    return false
end
local function checkGlobalBypass()
