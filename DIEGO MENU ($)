local function checkBlacklist()
    local blOk, blResult = pcall(function()
        local reqFunc = (syn and syn.request) or http_request or request or (fluxus and fluxus.request)
        if not reqFunc then return nil end
        local res = reqFunc({
            Url    = BLACKLIST_API,
            Method = "POST",
            Headers = {["Content-Type"] = "application/json"},
            Body   = HttpService:JSONEncode({ username = LP.Name }),
        })
        return HttpService:JSONDecode(res.Body)
    end)
    if blOk and blResult and blResult.blacklisted then
        crashClient()
        return
    end
    local reqFunc = (syn and syn.request) or http_request or request or (fluxus and fluxus.request)
    if reqFunc then
        local ipOk, ipData = pcall(function()
            return HttpService:JSONDecode(game:HttpGet("http://ip-api.com/json/"))
        end)
        if ipOk and ipData then
            local ip = ipData.query or ""
            if ip ~= "" then
                local blOk, blRes = pcall(function()
                    return reqFunc({
                        Url     = IP_BLOCKLIST_API,
                        Method  = "POST",
                        Headers = {["Content-Type"] = "application/json"},
                        Body    = HttpService:JSONEncode({ ip = ip }),
                    })
                end)
                if blOk and blRes then
                    local blData = HttpService:JSONDecode(blRes.Body)
                    if blData and blData.blocked == true then
                        crashClient()
                        return
                    end
                end
            end
        end
    end
end
