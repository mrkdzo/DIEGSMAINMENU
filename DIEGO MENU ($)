local function makeIcon(parent, tabKey, color, size)
    size = size or 20
    color = color or Color3.fromRGB(200, 200, 200)
    local container = Instance.new("Frame", parent)
    container.Size = UDim2.fromOffset(size, size)
    container.BackgroundTransparency = 1
    container.BorderSizePixel = 0
    container.ZIndex = (parent.ZIndex or 1) + 1
    local function line(x1,y1,x2,y2)
        local dx, dy = x2-x1, y2-y1
        local len = math.sqrt(dx*dx + dy*dy)
        local angle = math.atan2(dy, dx)
        local midX = (x1+x2)/2
        local midY = (y1+y2)/2
        local f = Instance.new("Frame", container)
        f.Size = UDim2.fromOffset(math.max(len,1), 2)
        f.Position = UDim2.fromOffset(midX - len/2, midY - 1)
        f.BackgroundColor3 = color
        f.BackgroundTransparency = 0
        f.BorderSizePixel = 0
        f.ZIndex = container.ZIndex + 1
        f.Rotation = math.deg(angle)
        Instance.new("UICorner", f).CornerRadius = UDim.new(1, 0)
        return f
    end
    local function dot(x, y, r)
        local f = Instance.new("Frame", container)
        f.Size = UDim2.fromOffset(r*2, r*2)
        f.Position = UDim2.fromOffset(x-r, y-r)
        f.BackgroundColor3 = color
        f.BackgroundTransparency = 0
        f.BorderSizePixel = 0
        f.ZIndex = container.ZIndex + 1
        Instance.new("UICorner", f).CornerRadius = UDim.new(1, 0)
        return f
    end
    local s = size
    local cx, cy = s/2, s/2
    if tabKey == "Combat" then
        line(cx, cy-7, cx, cy-3)
        line(cx, cy+3, cx, cy+7)
        line(cx-7, cy, cx-3, cy)
        line(cx+3, cy, cx+7, cy)
        dot(cx, cy, 2)
    elseif tabKey == "BigHead" then
        line(cx+2, cy-7, cx-2, cy)
        line(cx-2, cy, cx+2, cy)
        line(cx+2, cy, cx-2, cy+7)
    elseif tabKey == "ESP" then
        line(cx-6, cy, cx-2, cy-4)
        line(cx-2, cy-4, cx+2, cy-4)
        line(cx+2, cy-4, cx+6, cy)
        line(cx+6, cy, cx+2, cy+4)
        line(cx+2, cy+4, cx-2, cy+4)
        line(cx-2, cy+4, cx-6, cy)
        dot(cx, cy, 2)
    elseif tabKey == "Player" then
        line(cx-4, cy-2, cx-4, cy+5)
        line(cx-4, cy+5, cx+4, cy+5)
        line(cx+4, cy+5, cx+4, cy-2)
        dot(cx-4, cy-4, 2)
        line(cx, cy-2, cx, cy+5)
        dot(cx, cy-4, 2)
    elseif tabKey == "Character" then
        dot(cx, cy-5, 3)
        line(cx-4, cy, cx-4, cy+6)
        line(cx-4, cy+6, cx+4, cy+6)
        line(cx+4, cy+6, cx+4, cy)
        line(cx-4, cy, cx+4, cy)
    elseif tabKey == "Body" then
        line(cx-5, cy-5, cx, cy-2)
        line(cx, cy-2, cx+5, cy-5)
        line(cx-5, cy, cx, cy+3)
        line(cx, cy+3, cx+5, cy)
        line(cx-5, cy+4, cx, cy+7)
        line(cx, cy+7, cx+5, cy+4)
    elseif tabKey == "Whitelist" then
        line(cx, cy-7, cx+5, cy-4)
        line(cx+5, cy-4, cx+5, cy+1)
        line(cx+5, cy+1, cx, cy+6)
        line(cx, cy+6, cx-5, cy+1)
        line(cx-5, cy+1, cx-5, cy-4)
        line(cx-5, cy-4, cx, cy-7)
    elseif tabKey == "GunMods" then
        line(cx-7, cy-4, cx+7, cy-4)
        dot(cx-1, cy-4, 2)
        line(cx-7, cy, cx+7, cy)
        dot(cx+2, cy, 2)
        line(cx-7, cy+4, cx+7, cy+4)
        dot(cx-2, cy+4, 2)
    elseif tabKey == "Teleport" then
        dot(cx, cy-4, 3)
        line(cx-3, cy-1, cx, cy+6)
        line(cx+3, cy-1, cx, cy+6)
    elseif tabKey == "Settings" then
        dot(cx, cy, 4)
        dot(cx, cy, 2)
        line(cx, cy-7, cx, cy-4)
        line(cx, cy+4, cx, cy+7)
        line(cx-7, cy, cx-4, cy)
        line(cx+4, cy, cx+7, cy)
    else
        dot(cx, cy, 3)
    end
    return container
end
