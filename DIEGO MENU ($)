    local _espTick = 0
    RS.Heartbeat:Connect(function()
        if not S.ESPEnabled then
            if next(espObjects) then
                for uid, obj in pairs(espObjects) do
                    if obj.highlight then obj.highlight.Enabled = false end
                    if obj.nameLabel then obj.nameLabel.Visible = false end
                    if obj.healthBg then obj.healthBg.Visible = false end
                    if obj.boxLines then for _,l in pairs(obj.boxLines) do pcall(function() l.Visible=false end) end end
                end
            end
            return
        end
        _espTick = _espTick + 1
        if _espTick % 2 ~= 0 then return end  
        local isSlowFrame = (_espTick % 8 == 0)  
        local camCF = CAM.CFrame
        local camPos = camCF.Position
        for uid, obj in pairs(espObjects) do
            local pl=obj.player
            if not pl or not pl.Parent then
                if obj.boxLines then for _,l in pairs(obj.boxLines) do pcall(function() l:Destroy() end) end end
                if obj.nameDrawing then pcall(function() obj.nameDrawing:Destroy() end) end
                if obj.healthDrawing then pcall(function() obj.healthDrawing:Destroy() end) end
                if obj.headDotDrawing then pcall(function() obj.headDotDrawing:Destroy() end) end
                if obj.skeletonLines then for _,l in pairs(obj.skeletonLines) do pcall(function() l:Destroy() end) end end
                if obj.distDrawing then pcall(function() obj.distDrawing:Destroy() end) end
                espObjects[uid]=nil; continue
            end
            local char=pl.Character
            if not char then continue end
            local skip=isTeammateESP(pl) or isWhitelistedESP(pl)
            local baseOn = S.ESPEnabled and not skip
            if obj.highlight and isSlowFrame then
                local outlineOn = S.ESPEnabled and S.ESPOutline
                local chamsOn = S.ESPEnabled and S.ChamsEnabled
                local anyOn = outlineOn or chamsOn
                if obj.highlight.Enabled ~= anyOn then obj.highlight.Enabled = anyOn end
                if anyOn then
                    local fillTr = chamsOn and 0.5 or 1
                    local outTr  = outlineOn and 0 or 1
                    if math.abs(obj.highlight.FillTransparency - fillTr) > 0.01 then obj.highlight.FillTransparency = fillTr end
                    if math.abs(obj.highlight.OutlineTransparency - outTr) > 0.01 then obj.highlight.OutlineTransparency = outTr end
                    local col = getESPColor(pl)
                    if outlineOn and obj.highlight.OutlineColor ~= col then obj.highlight.OutlineColor = col end
                    if chamsOn and obj.highlight.FillColor ~= col then obj.highlight.FillColor = col end
                end
            end
            if obj.nameLabel then
                local want = baseOn and S.NameEnabled
                if obj.nameLabel.Visible ~= want then obj.nameLabel.Visible = want end
            end
            if obj.healthBg then
                local want = baseOn and S.HealthEnabled
                if obj.healthBg.Visible ~= want then obj.healthBg.Visible = want end
                if want and obj.humanoid and obj.healthFill then
                    local maxHp = obj.humanoid.MaxHealth > 0 and obj.humanoid.MaxHealth or 100
                    local pct = math.clamp(obj.humanoid.Health/maxHp, 0, 1)
                    obj.healthFill.Size = UDim2.new(pct, 0, 1, 0)
                    local r = math.floor((1-pct)*255)
                    local g = math.floor(pct*200)
                    obj.healthFill.BackgroundColor3 = Color3.fromRGB(r, g, 50)
                end
            end
            if baseOn and S.BoxEnabled and Drawing then
                local hrp = char:FindFirstChild("HumanoidRootPart")
                local head = char:FindFirstChild("Head")
                if hrp and head then
                    local hum = char:FindFirstChildOfClass("Humanoid")
                    local humanH = hum and hum.HipHeight or 2.5
                    local topPos = hrp.Position + Vector3.new(0, humanH+1.5, 0)
                    local botPos = hrp.Position - Vector3.new(0, humanH+0.5, 0)
                    local sp_top, vis1 = CAM:WorldToViewportPoint(topPos)
                    local sp_bot, vis2 = CAM:WorldToViewportPoint(botPos)
                    local sp_hrp = {X = (sp_top.X + sp_bot.X) * 0.5, Y = (sp_top.Y + sp_bot.Y) * 0.5}
                    local vis3 = vis1 or vis2
                    if vis3 then
                        local dist = (camPos - hrp.Position).Magnitude
                        if not obj.boxLines then
                            obj.boxLines = {mkLine(),mkLine(),mkLine(),mkLine()}
                        end
                        local h2d = math.abs(sp_top.Y - sp_bot.Y)
                        local w2d = h2d * 0.55
                        local cx = sp_hrp.X
                        local top = sp_top.Y; local bot = sp_bot.Y
                        local col = getESPColor(pl)
                        local lines = obj.boxLines
                        lines[1].From=Vector2.new(cx-w2d/2,top); lines[1].To=Vector2.new(cx+w2d/2,top)
                        lines[1].Color=col; lines[1].Visible=true
                        lines[2].From=Vector2.new(cx-w2d/2,bot); lines[2].To=Vector2.new(cx+w2d/2,bot)
                        lines[2].Color=col; lines[2].Visible=true
                        lines[3].From=Vector2.new(cx-w2d/2,top); lines[3].To=Vector2.new(cx-w2d/2,bot)
                        lines[3].Color=col; lines[3].Visible=true
                        lines[4].From=Vector2.new(cx+w2d/2,top); lines[4].To=Vector2.new(cx+w2d/2,bot)
                        lines[4].Color=col; lines[4].Visible=true
                        if S.NameEnabled then
                            if not obj.nameDrawing then obj.nameDrawing=mkText() end
                            if obj.nameDrawing then
                                obj.nameDrawing.Text=pl.DisplayName
                                obj.nameDrawing.Position=Vector2.new(cx, top-16)
                                obj.nameDrawing.Center=true
